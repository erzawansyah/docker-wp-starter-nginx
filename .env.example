# ======================================================
# PROJECT IDENTITY & PORTS
# ======================================================
# Container & volume name prefix (change for each project to avoid conflicts)
COMPOSE_PROJECT_NAME=wp-site-nginx

# Browser access ports
HTTP_PORT=8080
PMA_PORT=8081

# ======================================================
# WORDPRESS SITE INFORMATION
# ======================================================
WP_TITLE="My WordPress Site with Nginx"
WP_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=adminpassword123!
WP_ADMIN_EMAIL=admin@example.com

# ======================================================
# DATABASE CREDENTIALS
# ======================================================
DB_NAME=wordpress_db
DB_USER=wp_user
DB_PASSWORD=wp_secure_pass123!
DB_ROOT_PASSWORD=root_secure_pass123!
